PORT=3000

# Docker/Caddy alan adı. DNS A kaydı sunucu IP'sine yönlenmeli.
DOMAIN=chat.example.com

# KVKK metninde görünecek veri sorumlusu bilgileri
CONTROLLER_NAME=Adınız veya şirket unvanınız
CONTACT_EMAIL=kvkk@example.com
PRIVACY_UPDATED_AT=20 Kasım 2026
CONSENT_VERSION=2026-01

# Veri saklama süreleri (gün)
CHAT_RETENTION_DAYS=30
REPORT_RETENTION_DAYS=180
CONSENT_RETENTION_DAYS=365
AUDIT_RETENTION_DAYS=365

# SQLite veritabanı konumu (Docker'da /app/data olarak otomatik ayarlanır)
DATA_DIR=./data

# Yönetim paneli. En az 12 karakter kullanın.
# Boş bırakılırsa /admin kapalı olur.
ADMIN_USER=admin
ADMIN_PASSWORD=
